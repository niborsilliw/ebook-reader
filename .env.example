# Supabase project (EU region). Public values are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS; never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Mistral (La Plateforme, EU)
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-medium-latest
MISTRAL_EMBED_MODEL=mistral-embed
# Chat behaviour: "companion" (default, answered by Claude) or "grounded"
# (excerpts only, always cited, answered by Mistral)
CHAT_PROMPT_MODE=companion

# Anthropic (companion mode)
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5

# Shared secret for /api/ingest/step and /api/ingest/sweep
INGEST_SECRET=
# Vercel sets this for cron requests: Authorization: Bearer $CRON_SECRET
CRON_SECRET=
