# Supabase project (EU region). Public values are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS; never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Mistral (La Plateforme, EU)
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-medium-latest
MISTRAL_EMBED_MODEL=mistral-embed
# Chat behaviour: "companion" (default) or "grounded" (excerpts only, always cited)
CHAT_PROMPT_MODE=companion
# Exa web search, which the companion uses when the reader asks for outside
# context. Leave unset to turn web search off.
EXA_API_KEY=

# Shared secret the ingest worker sends when it chains its own next step
# (POST /api/books/[bookId]/ingest)
INGEST_SECRET=
